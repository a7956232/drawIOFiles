        <mxCell id="ETeao8j5pCn7Ap9Rbgfv-26" value="node:6&lt;br&gt;range:4-4&lt;br&gt;total:9&lt;br&gt;max:9&lt;br&gt;min:9" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
