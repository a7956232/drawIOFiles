        <mxCell id="ETeao8j5pCn7Ap9Rbgfv-22" value="node:5&lt;br&gt;range:3-3&lt;br&gt;total:6&lt;br&gt;max:6&lt;br&gt;min:6" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
